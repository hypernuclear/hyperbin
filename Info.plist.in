<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CFBundleIconFile</key>
	<string>hyperbin.icns</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<!-- Background agent: no Dock icon, no menu bar. The overlay and a
	     menu-bar item are the entire UI. -->
	<key>LSUIElement</key>
	<true/>


	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Sparkle. The feed is served over HTTPS and every item in it is
	     EdDSA-signed, so a compromised CDN still cannot ship a payload
	     this app will install. SUPublicEDKey is the public half; the
	     private half exists only as a GitHub secret. -->
	<key>SUFeedURL</key>
	<string>${HYPERBIN_APPCAST_URL}</string>
	<key>SUPublicEDKey</key>
	<string>${HYPERBIN_EDDSA_PUBKEY}</string>
	<!-- Checks are on, but nothing installs itself without being asked.
	     This app has no window most of the time; an update that swapped
	     the binary and relaunched unannounced would look like a crash. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>

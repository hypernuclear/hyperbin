{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Qt: QML: Attach by port",
      "type": "qml",
      "request": "attach",
      "host": "127.0.0.1",
      "port": "25684"
    },
    {
      // Everyday config: windowed dev mode with the stub trash target, so
      // the sim is iterable without fighting the Dock or the shell.
      "name": "hyperbin: Windowed (stub target)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        // NOTE: HYPERBIN_SHOW_BINRECT / HYPERBIN_BIN_ADJUST belong on the
        // Overlay config, not here — windowed mode never touches the Dock.
        // { "name": "QSG_INFO", "value": "1" },
        // { "name": "QSG_RENDER_TIMING", "value": "1" },
        // { "name": "QSG_RHI_BACKEND", "value": "metal" },
        // { "name": "QML_IMPORT_TRACE", "value": "1" },
        // { "name": "QT_LOGGING_RULES", "value": "*.debug=true" }
      ],
      "args": ["--windowed", "--stub"],
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb",
        "targetArchitecture": "arm64",
        "logging": {
          "moduleLoad": false
        }
      },
      "windows": {
        // Qt's debugger visualisers are MSVC-only, so they live here
        // rather than at the top level: evaluating them on macOS makes
        // the Qt extension demand a Qt path from the CMake presets and
        // block the launch.
        "visualizerFile": "${command:qt-cpp.natvis}",
        "showDisplayString": true,
        "environment": [
          {
            "name": "PATH",
            "value": "${env:PATH};${command:qt-cpp.qtDir}"
          },
          {
            "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
            "value": "${command:qt-cpp.QT_QPA_PLATFORM_PLUGIN_PATH}"
          },
          {
            "name": "QML_IMPORT_PATH",
            "value": "${command:qt-cpp.QML_IMPORT_PATH}"
          }
        ],
        "MIMode": "gdb",
        "miDebuggerPath": "${command:qt-cpp.minGWgdb}"
      }
    },
    {
      // Real overlay: frameless, click-through, positioned over the actual
      // trash icon. Note the overlay is click-through, so breakpoints are
      // the only way to inspect it — you can't click on it.
      "name": "hyperbin: Overlay",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        // cppdbg wants {"name","value"} pairs and silently ignores any
        // other shape, so {"VAR": "1"} looks right and does nothing.
        // { "name": "HYPERBIN_SHOW_BINRECT", "value": "1" }
        // { "name": "HYPERBIN_BIN_ADJUST", "value": "5,0,1" } // dx,dy,scale
        // { "name": "HYPERBIN_DEBUG", "value": "1" }
      ],
      "args": [],
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb",
        "targetArchitecture": "arm64",
        "logging": {
          "moduleLoad": false
        }
      },
      "windows": {
        // Qt's debugger visualisers are MSVC-only, so they live here
        // rather than at the top level: evaluating them on macOS makes
        // the Qt extension demand a Qt path from the CMake presets and
        // block the launch.
        "visualizerFile": "${command:qt-cpp.natvis}",
        "showDisplayString": true,
        "environment": [
          {
            "name": "PATH",
            "value": "${env:PATH};${command:qt-cpp.qtDir}"
          },
          {
            "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
            "value": "${command:qt-cpp.QT_QPA_PLATFORM_PLUGIN_PATH}"
          },
          {
            "name": "QML_IMPORT_PATH",
            "value": "${command:qt-cpp.QML_IMPORT_PATH}"
          }
        ],
        "MIMode": "gdb",
        "miDebuggerPath": "${command:qt-cpp.minGWgdb}"
      }
    },
    {
      // Windowed + QML debugger attached. Pair with the compound below.
      "name": "Qt: Debug with cppdbg and QML debugger",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "args": [
        "--windowed",
        "--stub",
        "-qmljsdebugger=host:127.0.0.1,port:25684,services:DebugMessages,QmlDebugger,V8Debugger,QmlInspector"
      ],
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb",
        "targetArchitecture": "arm64",
        "logging": {
          "moduleLoad": false
        }
      },
      "windows": {
        // Qt's debugger visualisers are MSVC-only, so they live here
        // rather than at the top level: evaluating them on macOS makes
        // the Qt extension demand a Qt path from the CMake presets and
        // block the launch.
        "visualizerFile": "${command:qt-cpp.natvis}",
        "showDisplayString": true,
        "environment": [
          {
            "name": "PATH",
            "value": "${env:PATH};${command:qt-cpp.qtDir}"
          },
          {
            "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
            "value": "${command:qt-cpp.QT_QPA_PLATFORM_PLUGIN_PATH}"
          },
          {
            "name": "QML_IMPORT_PATH",
            "value": "${command:qt-cpp.QML_IMPORT_PATH}"
          }
        ],
        "MIMode": "gdb",
        "miDebuggerPath": "${command:qt-cpp.minGWgdb}"
      }
    },
    {
      // Step into ONE test.
      //
      // For running them, use the Testing panel (the flask in the activity
      // bar) or select the `check` target and press build — CMake Tools
      // populates the panel from CTest, so every test function appears
      // there by name. This entry is for the other job: stopping inside a
      // failing one. Pass the test function as an argument to run just it,
      // e.g. "args": ["roll_doesNotLurch"]; with no arguments a Qt Test
      // binary runs every slot it has.
      "name": "Test: Tentacle chain (debug one)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tests/tentacle/tst_tentacle_chain",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "args": [],
      "osx": {
        "MIMode": "lldb",
        "targetArchitecture": "arm64"
      }
    },
    {
      // The swarm's contract: populates, moves, lands, walks, stays over
      // the bin, scales with it, and fully disperses when emptied.
      "name": "Test: Fly simulation (debug one)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tests/flies/tst_fly_sim",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "args": [],
      "osx": {
        "MIMode": "lldb",
        "targetArchitecture": "arm64"
      }
    }
  ],
  "compounds": [
    {
      "name": "C++/QML",
      "configurations": [
        "Qt: Debug with cppdbg and QML debugger",
        "Qt: QML: Attach by port"
      ]
    }
  ]
}
